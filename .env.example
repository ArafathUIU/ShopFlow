# -------------------------------------------------------------------
# ShopFlow environment template
# Copy to `.env` (root) for docker-compose variable substitution.
# NEVER commit real secrets. See .gitignore.
# -------------------------------------------------------------------

# --- PostgreSQL ---
# NOTE: 5432 is commonly occupied by a local Postgres (e.g. Laravel Herd);
# ShopFlow's Docker Postgres maps to 5433 to avoid conflicts.
POSTGRES_DB=shopflow
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow-secret
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Queue ---
QUEUE_CONNECTION=redis

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
